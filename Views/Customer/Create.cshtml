@model ASPCoreFirstApp.Models.Customer

<div style="width: 45%; margin: 40px auto; font-family: Arial, sans-serif;">
    <h2>Ajouter un Client</h2>
    <hr />

    @if (ViewBag.Errors != null)
    {
        <div style="color: red; margin-bottom: 15px;">
            <ul>
                @foreach (string error in ViewBag.Errors)
                {
                    <li>@error</li>
                }
            </ul>
        </div>
    }

    <form asp-action="Create" method="post">
        <div style="margin-bottom: 15px;">
            <label asp-for="Name" style="display: block; font-weight: bold;">Nom :</label>
            <input asp-for="Name" style="width: 100%; padding: 8px;" />
        </div>
        <div style="margin-bottom: 15px;">
            <label asp-for="Email" style="display: block; font-weight: bold;">Email :</label>
            <input asp-for="Email" style="width: 100%; padding: 8px;" />
        </div>
        <div style="margin-bottom: 15px;">
            <label asp-for="MembershipTypeId" style="display: block; font-weight: bold;">Type d'abonnement :</label>
            <select asp-for="MembershipTypeId" asp-items="ViewBag.Memberships" style="width: 100%; padding: 8px;"></select>
        </div>
        <button type="submit" style="padding: 8px 16px; background-color: #2980b9; color: white; border: none; border-radius: 4px;">Enregistrer</button>
        <a asp-action="Index" style="margin-left: 10px;">Annuler</a>
    </form>
</div>