@model ASPCoreFirstApp.Models.Genre

<div style="width: 40%; margin: 40px auto; font-family: Arial, sans-serif;">
    <h2>Ajouter un Genre</h2>
    <hr />

    <form asp-action="Create" method="post">
        <div style="margin-bottom: 15px;">
            <label asp-for="Name" style="display: block; font-weight: bold; margin-bottom: 5px;">Nom du Genre :</label>
            <input asp-for="Name" style="width: 100%; padding: 8px; border: 1px solid #ccc; border-radius: 4px;" required />
        </div>

        <button type="submit" style="padding: 8px 16px; background-color: #2980b9; color: white; border: none; border-radius: 4px; cursor: pointer;">
            Créer
        </button>
        <a asp-action="Index" style="margin-left: 10px; color: #555;">Retour à la liste</a>
    </form>
</div>  