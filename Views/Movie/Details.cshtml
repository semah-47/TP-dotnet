@model ASPCoreFirstApp.ViewModels.MovieDetailsViewModel

<div style="width: 65%; margin: 40px auto; font-family: Arial, sans-serif;">
    <h2>@Model.Movie.Name</h2>
    <p><strong>Genre :</strong> @(Model.Movie.Genre?.Name ?? "Non classé")</p>
    <p><strong>Disponibilité :</strong> @(Model.Movie.IsAvailable ? "Disponible" : "Loué")</p>
    <p><strong>Note moyenne :</strong> @(Model.Reviews.Count > 0 ? $"{Model.AverageRating} / 5 ({Model.Reviews.Count} avis)" : "Aucun avis")</p>

    @if (TempData["Error"] != null)
    {
        <div style="padding: 10px; background-color: #f8d7da; color: #721c24; border-radius: 4px; margin-bottom: 15px;">
            @TempData["Error"]
        </div>
    }
    
    @if (Model.Movie.IsAvailable)
    {
        <form asp-action="Rent" method="post" style="margin: 20px 0; padding: 15px; border: 1px solid #ddd; border-radius: 6px;">
            <input type="hidden" name="movieId" value="@Model.Movie.Id" />
            <label for="customerId"><strong>Louer à :</strong></label>
            <select name="customerId" asp-items="Model.Customers" style="padding: 6px; margin: 0 10px;"></select>
            <button type="submit" style="padding: 7px 14px; background-color: #2980b9; color: white; border: none; border-radius: 4px; cursor: pointer;">
                Louer
            </button>
        </form>
    }

    <hr style="margin: 30px 0;" />

    <h3>Donner un avis</h3>
    <form asp-action="AddReview" method="post" style="margin-bottom: 30px; padding: 15px; background-color: #f9f9f9; border-radius: 6px;">
        <input type="hidden" name="movieId" value="@Model.Movie.Id" />
        <div style="margin-bottom: 10px;">
            <label>Votre nom :</label>
            <input type="text" name="author" required style="width: 100%; padding: 6px;" />
        </div>
        <div style="margin-bottom: 10px;">
            <label>Note (1 à 5) :</label>
            <input type="number" name="rating" min="1" max="5" value="5" required style="width: 80px; padding: 6px;" />
        </div>
        <div style="margin-bottom: 10px;">
            <label>Commentaire :</label>
            <textarea name="comment" rows="3" style="width: 100%; padding: 6px;"></textarea>
        </div>
        <div style="margin-bottom: 10px;">
            <label>Étiquettes (séparées par des virgules) :</label>
            <input type="text" name="tags" placeholder="chef-d-oeuvre, visuel, bande-son" style="width: 100%; padding: 6px;" />
        </div>
        <div style="margin-bottom: 10px;">
            <label>Langue (optionnel) :</label>
            <input type="text" name="language" placeholder="FR, EN..." style="width: 120px; padding: 6px;" />
            <label style="margin-left: 20px;">
                <input type="checkbox" name="isSpoiler" value="true" /> Contient un spoiler
            </label>
        </div>
        <button type="submit" style="padding: 8px 16px; background-color: #27ae60; color: white; border: none; border-radius: 4px;">
            Publier l'avis
        </button>
    </form>
    
    <h3>Avis des spectateurs (@Model.Reviews.Count)</h3>
    @foreach (var review in Model.Reviews)
    {
        <div style="border-bottom: 1px solid #eee; padding: 12px 0;">
            <strong>@review.Author</strong> — ⭐ @review.Rating / 5
            @if (review.IsSpoiler == true)
            {
                <span style="background-color: #e74c3c; color: white; font-size: 11px; padding: 2px 6px; border-radius: 3px; margin-left: 8px;">SPOILER</span>
            }
            @if (!string.IsNullOrEmpty(review.Language))
            {
                <span style="color: #777; font-size: 12px;"> [@review.Language]</span>
            }
            <p style="margin: 6px 0;">@review.Comment</p>
            @if (review.Tags.Any())
            {
                <small style="color: #2980b9;">#@string.Join(" #", review.Tags)</small>
            }
        </div>
    }

    <p style="margin-top: 25px;"><a asp-action="Index">← Retour au catalogue</a></p>
</div>