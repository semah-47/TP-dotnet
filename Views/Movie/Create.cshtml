@model ASPCoreFirstApp.Models.Movie

<div style="width: 45%; margin: 40px auto; font-family: Arial, sans-serif;">
    <h2>Ajouter un Film</h2>
    <hr />

    @if (ViewBag.Errors != null)
    {
        <div style="color: #c0392b; background-color: #fadbd8; padding: 10px 15px; border-radius: 4px; margin-bottom: 15px;">
            <ul style="margin: 0;">
                @foreach (string error in ViewBag.Errors)
                {
                    <li>@error</li>
                }
            </ul>
        </div>
    }

    <form asp-action="Create" method="post">
        <div style="margin-bottom: 15px;">
            <label asp-for="Name" style="display: block; font-weight: bold;">Titre du Film :</label>
            <input asp-for="Name" style="width: 100%; padding: 8px;" />
            <span asp-validation-for="Name" style="color: #c0392b; font-size: 13px;"></span>
        </div>

        <div style="margin-bottom: 15px;">
            <label asp-for="GenreId" style="display: block; font-weight: bold;">Genre :</label>
            <select asp-for="GenreId" asp-items="ViewBag.Genres" style="width: 100%; padding: 8px;">
                <option value="">-- Sélectionner un Genre --</option>
            </select>
        </div>

        <button type="submit" style="padding: 8px 16px; background-color: #27ae60; color: white; border: none; border-radius: 4px; cursor: pointer;">
            Créer
        </button>
        <a asp-action="Index" style="margin-left: 10px;">Annuler</a>
    </form>
</div>